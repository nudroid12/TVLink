<resources>
    <style name="TVLinkTelevisionTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/tvlink_accent</item>
        <item name="android:alertDialogTheme">@style/TVLinkTvDialog</item>
    </style>
    <style name="TVLinkTvDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/tv_dialog_panel</item>
        <item name="android:colorBackground">@color/tvlink_surface</item>
        <item name="android:colorAccent">@color/tvlink_accent</item>
        <item name="android:textColorPrimary">@color/tvlink_text</item>
        <item name="android:textColorSecondary">@color/tvlink_secondary</item>
    </style>
</resources>
